# AppArmor profile for the LocalCloud daemon (PART II §1).
# Install to /etc/apparmor.d/usr.local.bin.localcloud-server, then:
#   apparmor_parser -r /etc/apparmor.d/usr.local.bin.localcloud-server
#   aa-status   # confirm `localcloud-server` is in "enforce" mode
#
# The profile is EXPLICITLY NAMED `localcloud-server`. Without a name, AppArmor
# derives the profile name from the attachment path (/opt/localcloud/venv/bin/
# python3) and `aa-status` reports *that* — which the acceptance check could
# never match. The name here MUST stay in sync with LOCALCLOUD_AA_PROFILE in
# deploy/scripts/localcloud-acceptance-check.sh.
#
# UNTESTED TEMPLATE. Confining a Python interpreter is fiddly — the profile
# must allow the venv + system libraries while denying everything else. Run in
# `complain` mode first (aa-complain) under a representative workload, then
# `aa-logprof` to absorb the legitimate accesses, then switch to enforce.
# This is defence-in-depth ON TOP OF the systemd sandbox in localcloud.service,
# not a replacement for it.

abi <abi/3.0>,
include <tunables/global>

# Named profile `localcloud-server`, attached to the interpreter hypercorn execs.
# attach_disconnected: under systemd PrivateDevices=yes, /dev is a private mount
# and AppArmor sees /dev/null etc. as "disconnected paths"; without this flag
# their lookups are denied. (hardware-tuned 2026-06-28, pentest D3)
profile localcloud-server /opt/localcloud/venv/bin/python3 flags=(enforce attach_disconnected) {
  include <abstractions/base>
  include <abstractions/python>
  include <abstractions/openssl>

  # Interpreter + application code: read/exec only (code is never writable).
  /opt/localcloud/venv/{,**} r,
  /opt/localcloud/venv/bin/python3* ix,
  /opt/localcloud/venv/**/*.so mr,
  /usr/lib/python3.*/{,**} r,
  /usr/bin/python3* ix,

  # Live data: the ONLY writable tree.
  /srv/cloud/ rw,
  /srv/cloud/** rwk,            # k = lock (SQLite WAL needs fcntl locks)

  # Session secret via the systemd credentials dir (read-only).
  @{run}/credentials/localcloud.service/session_secret r,

  # Networking on the WireGuard interface.
  network inet stream,
  network inet6 stream,
  network inet dgram,
  network inet6 dgram,

  # Entropy + basic process introspection.
  /dev/urandom r,
  /dev/random r,
  /dev/null rw,
  # hypercorn's worker manager creates multiprocessing POSIX semaphores in
  # /dev/shm even with --workers 1; without these the worker dies with
  # PermissionError on SemLock. (hardware-tuned 2026-06-28, pentest D3)
  /dev/shm/ rw,
  /dev/shm/* rwkl,
  owner @{PROC}/@{pid}/** r,

  # Quiet the harmless readline/terminfo probes Python emits at startup — the
  # server is non-interactive and does not need them. Plain `deny` (no `audit`)
  # blocks AND silences them so the audit log stays clean. (hardware 2026-06-28)
  deny /usr/share/terminfo/** r,
  deny /etc/inputrc r,

  # Hard denies (belt-and-suspenders; systemd already blocks most).
  deny /etc/shadow rwklx,
  deny /home/** rwklx,
  deny /root/** rwklx,
  audit deny /srv/cloud/** mx,   # never execute anything from the data dir
}
