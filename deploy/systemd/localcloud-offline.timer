# /etc/systemd/system/localcloud-offline.timer
# Scheduled downtime: close the WG port on a calendar (EXAMPLE: 23:00 daily).
[Unit]
Description=LocalCloud: scheduled offline window (close WG port)

[Timer]
OnCalendar=*-*-* 23:00:00
Persistent=false
Unit=localcloud-offline.service

[Install]
WantedBy=timers.target
